APP_NAME=TAPESH
APP_ENV=local
# تولید کلید: php artisan key:generate — مقدار واقعی هرگز commit نمی‌شود.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging (JSON تک‌خطی با request_id؛ بدون PII) ────────────────────
# api  = فایل storage/logs/api.log      (پیش‌فرض)
# stderr_json = stderr برای container / جمع‌آوری مرکزی
LOG_CHANNEL=api
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (PostgreSQL = system of record) ─────────────────────────
# توسعهٔ سریع محلی می‌تواند sqlite باشد؛ staging/production حتماً PostgreSQL.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tapesh
DB_USERNAME=tapesh
DB_PASSWORD=change-me

# ── Session / Cache / Queue ──────────────────────────────────────────
# فاز ۱: همه روی database تا هیچ وابستگی سخت به Redis نباشد.
# فازهای بعد (auth/queue زیر بار): session=redis، cache=redis، queue=redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=tapesh

# ── Redis (cache / queue / rate limiting / session در فازهای بعد) ────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── API foundation ───────────────────────────────────────────────────
API_REQUEST_ID_HEADER=X-Request-Id
READYZ_CHECK_DATABASE=true
READYZ_CHECK_REDIS=true
REDIS_READYZ_CONNECTION=cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Queue (فاز ۱۹) ───────────────────────────────────────────────────
# نام صف‌ها و سیاست retry/backoff/timeout در config/queue.php («tapesh»).
# staging/production: QUEUE_CONNECTION=redis (پیش‌فرض توسعه: database).
QUEUE_NAME_DEFAULT=default
QUEUE_NAME_NOTIFICATIONS=notifications
QUEUE_NAME_SEARCH=search
QUEUE_NAME_OUTBOX=outbox

QUEUE_TRIES_DEFAULT=3
QUEUE_TRIES_NOTIFICATIONS=3
QUEUE_TRIES_SEARCH=3
QUEUE_TRIES_OUTBOX=3
QUEUE_TIMEOUT_DEFAULT=60
QUEUE_TIMEOUT_NOTIFICATIONS=20
QUEUE_TIMEOUT_SEARCH=30
QUEUE_TIMEOUT_OUTBOX=30

# Dead letter (failed_jobs) — مشاهده از پنل، پاک‌سازی زمان‌بند.
QUEUE_FAILED_RETENTION_DAYS=30
QUEUE_FAILED_PRUNE_BATCH=200

# Worker: غیر root، bounded، graceful shutdown.
QUEUE_WORKER_SLEEP=1
QUEUE_WORKER_MAX_TIME=3600
QUEUE_WORKER_MEMORY=256
QUEUE_WORKER_GRACE=5

# ── Outbox (فاز ۱۹) ──────────────────────────────────────────────────
OUTBOX_SWEEP_ENABLED=true
OUTBOX_SWEEP_BATCH=200
OUTBOX_SWEEP_MAX_AGE_HOURS=24
OUTBOX_RETENTION_DAYS=14
OUTBOX_PAYLOAD_MAX_BYTES=8192

# ── Notifications (فاز ۱۹) ───────────────────────────────────────────
# فقط in_app مسیر واقعی این فاز است. email/sms/push تا وقتی Provider،
# Consent و Quota واقعی وجود ندارد خاموش می‌مانند (هیچ تحویل دروغینی ثبت نمی‌شود).
NOTIFICATIONS_PER_PAGE=20
NOTIFICATIONS_MAX_PER_PAGE=50
NOTIFICATIONS_TITLE_MAX=240
NOTIFICATIONS_BODY_MAX=2000
NOTIFICATIONS_DELIVERY_TRIES=3
NOTIFICATIONS_DELIVERY_TIMEOUT=20
NOTIFICATIONS_BROADCAST_CHUNK=200
NOTIFICATIONS_BROADCAST_MAX=100000
NOTIFICATIONS_READ_RETENTION_DAYS=90
NOTIFICATIONS_RETENTION_DAYS=365
NOTIFICATIONS_PRUNE_BATCH=500

NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_PROVIDER=null
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_PROVIDER=null
NOTIFICATIONS_PUSH_ENABLED=false
NOTIFICATIONS_PUSH_PROVIDER=null

# ── Search (فاز ۱۹) ──────────────────────────────────────────────────
# موتور: PostgreSQL FTS. هیچ موتور بیرونی اضافه نشد (بدون اندازه‌گیری واقعی).
SEARCH_PER_PAGE=15
SEARCH_MAX_PER_PAGE=40
SEARCH_MIN_LENGTH=2
SEARCH_MAX_LENGTH=120
SEARCH_MAX_CANDIDATES=200
SEARCH_INDEX_BATCH=200
SEARCH_INDEX_TRIES=3
SEARCH_INDEX_TIMEOUT=30
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL=60

# ── Admin / Audit / Settings (فاز ۲۰) ────────────────────────────────
ADMIN_USERS_PER_PAGE=30
ADMIN_USERS_MAX_PER_PAGE=100
AUDIT_PER_PAGE=30
AUDIT_MAX_PER_PAGE=100
AUDIT_RETENTION_DAYS=730
AUDIT_RETENTION_BATCH=500
SETTINGS_PER_PAGE=50
