# متغیرهای محیطی پنل مدیریت تپش
# این فایل را به .env کپی کنید. فایل .env هرگز Commit نمی‌شود.
#
# `.env` واقعاً خوانده می‌شود: `vite.config.js` (برای `npm run dev`) و
# `server.js` (برای `npm run start`) آن را با `process.loadEnvFile` خودِ نود
# داخل `process.env` می‌نویسند. ویت به‌تنهایی این کار را نمی‌کند — `.env` را
# فقط برای مرورگر و فقط کلیدهای `VITE_*` می‌خواند، پس متغیرهای سروری بدون آن
# خط بی‌صدا نادیده گرفته می‌شدند.
# متغیری که در پوسته export شده باشد بر مقدار فایل مقدم است.

# ── حساب اولیهٔ مدیر کل ─────────────────────────────────────────────
# فقط در اولین اجرا خوانده می‌شود (وقتی database/content/admins.json ساخته می‌شود).
# اگر رمز تنظیم نشود، مقدار پیش‌فرض 0135 استفاده می‌شود و پنل از شما می‌خواهد
# آن را از «حساب من» تغییر دهید.
TAPESH_ADMIN_USERNAME=0135
TAPESH_ADMIN_PASSWORD=0135
TAPESH_ADMIN_NAME=مدیر تپش
TAPESH_ADMIN_EMAIL=

# ── سرور پروداکشن (npm run start) ──────────────────────────────────
PORT=4173
HOST=0.0.0.0

# کوکی نشست در NODE_ENV=production پرچم Secure می‌گیرد. اگر پروداکشن را روی
# http محلی سرو می‌کنید، این را ۱ بگذارید تا ورود کار کند.
# TAPESH_INSECURE_COOKIE=1

# ── ورود / ثبت‌نام با گوگل ─────────────────────────────────────────
#
# در Google Cloud Console → APIs & Services → Credentials یک «OAuth client ID»
# از نوع «Web application» بسازید و این دو مقدار را از همان‌جا بردارید.
#
# در «Authorized redirect URIs» این آدرس‌ها را ثبت کنید (هر کدام یک خط جدا):
#   http://localhost:5173/api/auth/google/callback     ← توسعه
#   https://<دامنهٔ سایت>/api/auth/google/callback     ← پروداکشن
#
# ⚠️ در توسعه حتماً سایت را با `http://localhost:5173` باز کنید، نه
# `http://127.0.0.1:5173` و نه `http://[::1]:5173`. کوکیِ گاردِ state به «میزبان»
# گره خورده است؛ اگر با یک میزبان شروع کنید و گوگل به میزبان دیگری برگرداند،
# کوکی فرستاده نمی‌شود و هر بار خطای «نشست منقضی شد» می‌گیرید. آدرس بازگشتی هم
# باید بیت‌به‌بیت همان چیزی باشد که در Console ثبت کرده‌اید.
#
# تا وقتی این دو خالی باشند، دکمهٔ گوگل در `#auth` غیرفعال (مرز خط‌چین) می‌ماند
# و صریحاً می‌گوید که پیکربندی نشده است — هیچ ورود ساختگی‌ای انجام نمی‌شود.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# اگر پروداکشن پشت پروکسی است (هدر Host دامنهٔ داخلی را می‌دهد)، `PUBLIC_SITE_URL`
# پایین را هم بگذارید تا آدرس بازگشت همان دامنهٔ عمومی ساخته شود.

# ── انتشار در کانال‌های پیام‌رسان ──────────────────────────────────
#
# توکن ربات را لازم نیست اینجا بگذارید: در پنل، بخش «انتشار در کانال‌ها» → کارت
# «کانال‌ها» → «ثبت توکن»، هر کانال توکن خودش را دارد و در
# `database/publishing.secrets.json` با مجوز ۰۶۰۰ ذخیره می‌شود (خارج از Git).
#
# متغیرهای زیر فقط برای حالت‌های خاص‌اند:

# توکن پیش‌فرض بله — فقط اگر روی خود کانال توکنی ثبت نشده باشد استفاده می‌شود.
# BALE_BOT_TOKEN=

# آدرس پایهٔ API بله. فقط اگر بله آدرس را عوض کرد یا از واسطه استفاده می‌کنید.
# پیش‌فرض: https://tapi.bale.ai/bot
# BALE_API_BASE=

# توکن پیش‌فرض تلگرام (از @BotFather). اولویت با توکن خودِ کانال در پنل است.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE=https://api.telegram.org/bot

# توکن پیش‌فرض ایتایار (از پنل eitaayar.ir → بخش API).
# توجه: ایتایار متد بررسی کانال (getChat) و شمارش اعضا ندارد. پس «تست اتصال» فقط
# توکن را تأیید می‌کند و بررسی کانال «بررسی‌نشده» می‌ماند؛ تأیید نهایی دسترسی با
# اولین ارسال واقعی معلوم می‌شود. سنجهٔ دنبال‌کننده هم نمایش داده نمی‌شود.
# EITAA_BOT_TOKEN=
# EITAA_API_BASE=https://eitaayar.ir/api

# مهلت پاسخ سرویس‌های بیرونی انتشار (میلی‌ثانیه). پیش‌فرض ۱۵۰۰۰.
# PUBLISH_TIMEOUT_MS=

# حالت آزمایشی سراسری: ۱ = هیچ پیامی واقعاً فرستاده نمی‌شود و همهٔ تلاش‌ها
# «آزمایشی» ثبت می‌شوند. برای تمرین بدون ریسک انتشار اشتباه.
# PUBLISH_DRY_RUN=

# آدرس عمومی سایت — برای ساختن لینک مقاله در متن پیام.
# اگر خالی بماند، متن پیام فقط عنوان و خلاصه را می‌گیرد.
# PUBLIC_SITE_URL=https://tapesh.ir

# ── APIهای مرکز رسانه و فضای مجازی ─────────────────────────────────
#
# توکن هر اکانت را می‌توان از داخل مرکز رسانه → اکانت‌ها ثبت کرد؛ مقدار آن در
# `database/media.secrets.json` با مجوز ۰۶۰۰ می‌ماند و هیچ‌وقت به UI برنمی‌گردد.
# متغیر محیطی فقط fallback است؛ اگر هم‌زمان هر دو وجود داشته باشند، کلید خود
# اکانت اولویت دارد. بدون کلید، هیچ درخواست بیرونی ارسال نمی‌شود و dry-run ثبت می‌شود.
#
# متغیرهای TELEGRAM_* و EITAA_* که پیش‌تر اینجا فهرست شده بودند، در عمل هیچ‌جا
# خوانده نمی‌شدند؛ جای واقعی‌شان بخش «انتشار در کانال‌های پیام‌رسان» بالاست.
# (هر دو برای آداپتورهای انتشار هستند، نه برای اکانت‌های مرکز رسانه.)
#
# Instagram Graph API (نیازمند App ID/Secret + Access Token):
# INSTAGRAM_GRAPH_BASE=https://graph.facebook.com/v21.0
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# PUBLIC_SITE_URL=https://tapesh.ir
#
# ── مرکز تحلیل ─────────────────────────────────────────────────────
#
# هیچ‌کدام از این‌ها اجباری نیستند. مرکز تحلیل با همان دادهٔ داخلی پروژه
# (users.json، content/*.json، گزارش رویدادها، تلمتری مرورگر، سنجه‌های سرور)
# کار می‌کند. هر متغیری که تنظیم شود، بخش وابسته به آن از حالت «نیازمند اتصال»
# به حالت فعال می‌رود — و اگر تنظیم نشود، پنل به‌جای عدد ساختگی صادقانه
# می‌گوید که منبع وصل نیست. متغیرها فقط در سرور خوانده می‌شوند و هرگز به
# مرورگر فرستاده نمی‌شوند.
#
# ⚠️ وضعیت واقعی (بازبینی ۲۰۲۶-۱۰-۰۱ — PHASE 19/20):
#   کلیدهای این بخش در کد فقط با `configured()` در `database/analyticsStore.js`
#   خوانده می‌شوند؛ یعنی **وجود** کلید برای نمایش «وصل/قطع» سنجیده می‌شود و
#   **هیچ درخواست شبکه‌ای به سرویس بیرونی زده نمی‌شود**. وضعیت همه:
#   `CONFIGURED BUT UNUSED` — «تنظیم‌شده اما بی‌مصرف».
#   ⇒ تنظیم کردن این کلیدها فقط برچسب پنل را عوض می‌کند، نه دادهٔ نمایش‌داده‌شده.
#   برای «فعال‌شدن» واقعی باید مصرف‌کنندهٔ شبکه‌ای نوشته شود.
#   تنها استثنا: `GOOGLE_CLIENT_ID`/`GOOGLE_CLIENT_SECRET` که مصرف‌کنندهٔ واقعی
#   دارند (`database/googleAuth.js`) و ورود با گوگل را فعال می‌کنند.

# Google Analytics 4 — برای ترافیک دقیق‌تر و مقایسه با دادهٔ داخلی
# (نیازمند هر سه مورد)
# GA_PROPERTY_ID=
# GA_CLIENT_EMAIL=
# GA_PRIVATE_KEY=

# Google Search Console — کلیک، نمایش، CTR و رتبهٔ کلمات کلیدی
# از همان حساب سرویس GA استفاده می‌کند، پس GA_CLIENT_EMAIL و GA_PRIVATE_KEY
# هم باید تنظیم باشند.
# GSC_SITE_URL=

# Google PageSpeed Insights — امتیاز Lighthouse و بررسی آزمایشگاهی سرعت
# PAGESPEED_API_KEY=

# درگاه پرداخت — درآمد، خرید، AOV، نرخ تبدیل به خرید، بازگشت وجه
# ⚠️ CONFIGURED BUT UNUSED: هیچ route، adapter، webhook، idempotency یا
#    reconciliation در کد وجود ندارد. تصمیم محصول لازم است (پیاده‌سازی یا حذف).
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=

# مدل زبانی — فقط برای افزودن «روایت متنی» به تحلیلگر هوشمند.
# تحلیلگر بدون این هم کامل کار می‌کند (رگرسیون + امتیاز Z + ریشه‌یابی).
# ⚠️ CONFIGURED BUT UNUSED: `LLM_API_KEY` در کد فقط به‌عنوان `requires` اعلام
#    شده و هیچ فراخوانی HTTP ندارد. `src/services/ai/mockAI.js` یک شبیه‌ساز است.
# LLM_API_KEY=
# LLM_MODEL=

# سرویس مانیتورینگ بیرونی (مثل UptimeRobot / Better Stack)
# MONITORING_API_URL=
# MONITORING_API_KEY=

# کانال اعلان هشدارها — وب‌هوک عمومی یا ربات تلگرام
# ALERT_WEBHOOK_URL=
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT=

# تحلیل جغرافیایی (کشور/شهر بازدیدکنندگان) در این نسخه به منبع GeoIP وصل
# نیست و بخش «موقعیت جغرافیایی» حالت «نیازمند اتصال» نشان می‌دهد.
