# متغیرهای محیطی پنل مدیریت تپش
# این فایل را به .env کپی کنید. فایل .env هرگز Commit نمی‌شود.

# ── حساب اولیهٔ مدیر کل ─────────────────────────────────────────────
# فقط در اولین اجرا خوانده می‌شود (وقتی database/content/admins.json ساخته می‌شود).
# اگر رمز تنظیم نشود، مقدار پیش‌فرض 0135 استفاده می‌شود و پنل از شما می‌خواهد
# آن را از «حساب من» تغییر دهید.
TAPESH_ADMIN_USERNAME=0135
TAPESH_ADMIN_PASSWORD=0135
TAPESH_ADMIN_NAME=مدیر تپش
TAPESH_ADMIN_EMAIL=

# ── سرور پروداکشن (npm run start) ──────────────────────────────────
PORT=4173
HOST=0.0.0.0

# کوکی نشست در NODE_ENV=production پرچم Secure می‌گیرد. اگر پروداکشن را روی
# http محلی سرو می‌کنید، این را ۱ بگذارید تا ورود کار کند.
# TAPESH_INSECURE_COOKIE=1

# ── مرکز تحلیل ─────────────────────────────────────────────────────
#
# هیچ‌کدام از این‌ها اجباری نیستند. مرکز تحلیل با همان دادهٔ داخلی پروژه
# (users.json، content/*.json، گزارش رویدادها، تلمتری مرورگر، سنجه‌های سرور)
# کار می‌کند. هر متغیری که تنظیم شود، بخش وابسته به آن از حالت «نیازمند اتصال»
# به حالت فعال می‌رود — و اگر تنظیم نشود، پنل به‌جای عدد ساختگی صادقانه
# می‌گوید که منبع وصل نیست. متغیرها فقط در سرور خوانده می‌شوند و هرگز به
# مرورگر فرستاده نمی‌شوند.

# Google Analytics 4 — برای ترافیک دقیق‌تر و مقایسه با دادهٔ داخلی
# (نیازمند هر سه مورد)
# GA_PROPERTY_ID=
# GA_CLIENT_EMAIL=
# GA_PRIVATE_KEY=

# Google Search Console — کلیک، نمایش، CTR و رتبهٔ کلمات کلیدی
# از همان حساب سرویس GA استفاده می‌کند، پس GA_CLIENT_EMAIL و GA_PRIVATE_KEY
# هم باید تنظیم باشند.
# GSC_SITE_URL=

# Google PageSpeed Insights — امتیاز Lighthouse و بررسی آزمایشگاهی سرعت
# PAGESPEED_API_KEY=

# درگاه پرداخت — درآمد، خرید، AOV، نرخ تبدیل به خرید، بازگشت وجه
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=

# مدل زبانی — فقط برای افزودن «روایت متنی» به تحلیلگر هوشمند.
# تحلیلگر بدون این هم کامل کار می‌کند (رگرسیون + امتیاز Z + ریشه‌یابی).
# LLM_API_KEY=
# LLM_MODEL=

# سرویس مانیتورینگ بیرونی (مثل UptimeRobot / Better Stack)
# MONITORING_API_URL=
# MONITORING_API_KEY=

# کانال اعلان هشدارها — وب‌هوک عمومی یا ربات تلگرام
# ALERT_WEBHOOK_URL=
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT=

# تحلیل جغرافیایی (کشور/شهر بازدیدکنندگان) در این نسخه به منبع GeoIP وصل
# نیست و بخش «موقعیت جغرافیایی» حالت «نیازمند اتصال» نشان می‌دهد.
